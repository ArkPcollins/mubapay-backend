{
  "name": "mubapay-backend-wredis",
  "version": "1.0.0",
  "private": true,
  "description": "MubaPay API — Express/MongoDB modular monolith",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:worker": "node --env-file-if-exists=.env src/worker.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js up",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate.js status",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-superadmin": "node --env-file-if-exists=.env scripts/create-superadmin.js",
    "lint": "eslint src scripts tests",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:financial": "jest --runInBand tests/financial",
    "test:workflows": "jest --runInBand tests/workflows",
    "test:failure": "jest --runInBand tests/failure"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mongodb-memory-server-core": "^10.1.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "globalSetup": "<rootDir>/tests/helpers/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/helpers/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/helpers/setupEnv.js"
    ]
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "fsevents@2.3.3": true
  }
}
