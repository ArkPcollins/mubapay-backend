# =====================================================================
# MubaPay backend configuration — Version A (MongoDB only, no Redis)
# Copy to .env and fill in. NEVER commit .env. Values here are placeholders,
# not working credentials. Every integration stays switched off until its
# real credentials are supplied.
# =====================================================================

# --- Runtime ---------------------------------------------------------
APP_ENV=development            # development | staging | production
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=                  # comma-separated; defaults to FRONTEND_URL
TRUST_PROXY=0                  # set to 1 behind one reverse proxy (nginx in docker-compose)
LOG_LEVEL=info

# --- Database (MongoDB replica set REQUIRED: money moves use transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/mubapay?replicaSet=rs0
# This version does not use Redis. Queues, cache and rate limits live in MongoDB.

# --- Sessions & encryption -------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false            # must be true in production (HTTPS)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored identity documents and bank numbers unreadable. Back it up separately.
DATA_ENCRYPTION_KEY=
PRIVATE_STORAGE_DIR=./private-storage
DOWNLOAD_TOKEN_TTL_SECONDS=120

# --- Paystack (payments; transfers only if enabled on your Paystack account)
PAYSTACK_MODE=test             # production requires live
PAYSTACK_SECRET_KEY=           # sk_test_... in development/staging
PAYSTACK_PUBLIC_KEY=           # pk_test_...
PAYSTACK_TRANSFERS_ENABLED=false

# --- Email (Brevo) ---------------------------------------------------
EMAIL_TRANSPORT=console        # brevo | console (dev only: prints to log) | disabled
BREVO_API_KEY=
BREVO_INBOUND_SECRET=          # random string used in the inbound-parse webhook URL
EMAIL_FROM_ADDRESS=no-reply@your-domain.ng
EMAIL_FROM_NAME=MubaPay
SUPPORT_EMAIL=support@your-domain.ng

# --- Phone verification & WhatsApp support (Meta WhatsApp Cloud API) --
PHONE_OTP_TRANSPORT=console    # whatsapp | console (dev only) | disabled
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE=         # an approved authentication template name
WHATSAPP_OTP_TEMPLATE_LANG=en

# --- Google sign-in (optional) ---------------------------------------
GOOGLE_CLIENT_ID=

# --- Media (Cloudinary signed uploads) --------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mubapay

# --- Delivery (Shipbubble) -------------------------------------------
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_SENDER_ADDRESS_CODE=
SHIPBUBBLE_DEFAULT_CATEGORY_ID=

# --- Geocoding (OpenStreetMap Nominatim; respect the usage policy) ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=          # e.g. "MubaPay/1.0 (ops@your-domain.ng)"; empty = disabled
NOMINATIM_EMAIL=

# --- Operations ------------------------------------------------------
ALERT_WEBHOOK_URL=             # optional: critical alerts are POSTed here
HEALTH_DETAILS_TOKEN=
RUN_WORKER_IN_PROCESS=true
RUN_SCHEDULER=true
ENABLE_SEED_DATA=false         # dev only; refused in production
